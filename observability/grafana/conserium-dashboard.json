{
  "title": "Conserium Backend",
  "uid": "conserium-backend",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Query Latency",
      "targets": [
        {
          "expr": "rate(conserium_query_latency_seconds_sum[5m]) / clamp_min(rate(conserium_query_latency_seconds_count[5m]), 1e-9)"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Ingestion Latency",
      "targets": [
        {
          "expr": "rate(conserium_ingestion_latency_seconds_sum[5m]) / clamp_min(rate(conserium_ingestion_latency_seconds_count[5m]), 1e-9)"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Embedding Cache Events",
      "targets": [
        {
          "expr": "sum by (status) (conserium_embedding_cache_events_total)"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Reranker Events",
      "targets": [
        {
          "expr": "sum by (backend, status) (conserium_reranker_events_total)"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Eval Scores",
      "targets": [
        {
          "expr": "sum by (score) (conserium_query_eval_score_sum) / clamp_min(sum by (score) (conserium_query_eval_score_count), 1)"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "targets": [
        {
          "expr": "conserium_queue_depth"
        }
      ],
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8}
    }
  ]
}
